[Unit]
Description=wifisense - presence detection from Wi-Fi channel perturbations
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
# Adapt user and paths. With a LimeSDR the user must belong to the group granted
# access by the limesuite udev rules, otherwise the device cannot be opened
# without root.
User=CHANGEME
WorkingDirectory=/opt/wifisense
ExecStart=/opt/wifisense/venv/bin/python -m wifisense run \
          --config /opt/wifisense/config.yaml \
          --calibration /opt/wifisense/calibration.yaml
Restart=always
RestartSec=10

# The DSP must keep up with the input stream: without priority, another process
# loading the machine causes overflows and gaps in the measurement.
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/wifisense

[Install]
WantedBy=multi-user.target
